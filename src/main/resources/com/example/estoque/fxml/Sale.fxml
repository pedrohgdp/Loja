<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.estoque.controller.SaleController">
   <children>
      <Label fx:id="noteNumber" layoutX="30.0" layoutY="23.0" prefHeight="37.0" prefWidth="187.0" text="Numero Nota:" />
      <Label fx:id="client" layoutX="30.0" layoutY="71.0" prefHeight="53.0" prefWidth="523.0" text="Cliente:" />
      <CheckBox fx:id="takeClient" layoutX="30.0" layoutY="137.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="187.0" text="Adicionar Cliente" />
      <TableView fx:id="itens" layoutX="24.0" layoutY="192.0" prefHeight="384.0" prefWidth="1035.0">
        <columns>
          <TableColumn fx:id="code" prefWidth="125.0" text="Codigo" />
          <TableColumn fx:id="description" prefWidth="508.0" text="Descricao" />
            <TableColumn fx:id="soloPrice" prefWidth="106.0" text="Preco Unitario" />
            <TableColumn fx:id="amount" prefWidth="87.0" text="Quantidade " />
            <TableColumn fx:id="totalPrice" minWidth="0.0" prefWidth="92.0" text="Preco Total" />
            <TableColumn fx:id="brand" prefWidth="114.0" text="Marca" />
        </columns>
      </TableView>
      <Label fx:id="priceLabel" layoutX="867.0" layoutY="576.0" prefHeight="30.0" prefWidth="187.0" text="Valor:" />
      <Label fx:id="discountTextArea" layoutX="867.0" layoutY="606.0" prefHeight="30.0" prefWidth="178.0" text="Desconto:" />
      <Label fx:id="finalPriceLabel" layoutX="867.0" layoutY="636.0" prefHeight="30.0" prefWidth="178.0" text="Valor Final:" />
      <Button fx:id="printNote" layoutX="867.0" layoutY="666.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="209.0" text="Imprimir" />
      <Button fx:id="addItem" layoutX="24.0" layoutY="591.0" mnemonicParsing="false" onAction="#setOnAddItemButton" prefHeight="30.0" prefWidth="151.0" text="Adicionar Item" />
      <Button fx:id="removeItem" layoutX="196.0" layoutY="591.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="151.0" text="Remover Item" onAction="#setOnRemoveItemButton"/>
      <TextField fx:id="discountTextField" layoutX="934.0" layoutY="610.0" prefHeight="22.0" prefWidth="141.0" />
   </children>
</AnchorPane>
